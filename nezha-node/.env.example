# Copy these into the Deplexo dashboard under Settings > Environment.
# Never commit real values. The agent secret comes from the Nezha panel
# when you add a new agent entry.

# Panel gRPC address. The port defaults to 8008 when omitted.
NZ_SERVER=panel.example.com:8008

# The client secret for this agent, copied from the panel.
NZ_CLIENT_SECRET=

# TLS on the agent's gRPC connection.
#
# Leave this FALSE for a Nezha v1 panel (1.14.x): it serves gRPC in
# plaintext only, and an agent with TLS enabled fails the handshake with
# "tls: first record does not look like a TLS handshake".
#
# Set to true only if the panel is a v2 panel (2.x) that serves gRPC over TLS.
NZ_TLS=false

# Set to true only for a self-signed panel certificate.
# NZ_INSECURE_TLS=false
